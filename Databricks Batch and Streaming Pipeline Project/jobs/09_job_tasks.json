{
  "name": "retail_lakehouse_daily_job",

  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "Asia/Kolkata",
    "pause_status": "UNPAUSED"
  },

  "max_concurrent_runs": 1,

  "tasks": [

    {
      "task_key": "batch_ingestion",

      "notebook_task": {
        "notebook_path": "/Workspace/Users/RetailLakehouse/notebooks/01_batch_copy_into"
      }
    },

    {
      "task_key": "silver_transform",

      "depends_on": [
        {
          "task_key": "batch_ingestion"
        }
      ],

      "notebook_task": {
        "notebook_path": "/Workspace/Users/RetailLakehouse/notebooks/04_silver_transform"
      }
    },

    {
      "task_key": "gold_revenue",

      "depends_on": [
        {
          "task_key": "silver_transform"
        }
      ],

      "notebook_task": {
        "notebook_path": "/Workspace/Users/RetailLakehouse/notebooks/05_gold_revenue"
      }
    },

    {
      "task_key": "gold_customers",

      "depends_on": [
        {
          "task_key": "silver_transform"
        }
      ],

      "notebook_task": {
        "notebook_path": "/Workspace/Users/RetailLakehouse/notebooks/06_gold_customers"
      }
    }
  ]
}
