{
  "datasets": [
    {
      "name": "481be480",
      "displayName": "KPI — Total Revenue",
      "queryLines": [
        "SELECT\r\n",
        "    ROUND(SUM(total_revenue), 2) AS total_revenue\r\n",
        "FROM retail_lakehouse.gold.gold_revenue;"
      ],
      "catalog": "retail_lakehouse",
      "schema": "gold"
    },
    {
      "name": "d50ece1c",
      "displayName": "KPI — Total Orders",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(total_orders) AS total_orders\r\n",
        "FROM retail_lakehouse.gold.gold_revenue;"
      ],
      "catalog": "retail_lakehouse",
      "schema": "gold"
    },
    {
      "name": "8e855cb9",
      "displayName": "KPI — Total Units",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(total_units) AS total_units\r\n",
        "FROM retail_lakehouse.gold.gold_revenue;"
      ]
    },
    {
      "name": "fdb13ea3",
      "displayName": "Revenue trend",
      "queryLines": [
        "SELECT\r\n",
        "    order_date,\r\n",
        "    ROUND(total_revenue, 2) AS revenue\r\n",
        "FROM retail_lakehouse.gold.gold_revenue\r\n",
        "ORDER BY order_date;"
      ]
    },
    {
      "name": "802b390c",
      "displayName": "Orders trend",
      "queryLines": [
        "SELECT\r\n",
        "    order_date,\r\n",
        "    total_orders\r\n",
        "FROM retail_lakehouse.gold.gold_revenue\r\n",
        "ORDER BY order_date;"
      ]
    },
    {
      "name": "6b22b14c",
      "displayName": "Top 10 customers",
      "queryLines": [
        "SELECT\r\n",
        "    customer_id,\r\n",
        "    total_orders,\r\n",
        "    ROUND(total_spend, 2) AS total_spend,\r\n",
        "    last_order_date\r\n",
        "FROM retail_lakehouse.gold.gold_customers\r\n",
        "ORDER BY total_spend DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "e2cfeb26",
      "displayName": "Customer revenue distribution segment",
      "queryLines": [
        "SELECT\r\n",
        "    CASE\r\n",
        "        WHEN total_spend >= 20000 THEN 'VIP'\r\n",
        "        WHEN total_spend >= 10000 THEN 'HIGH_VALUE'\r\n",
        "        WHEN total_spend >= 5000 THEN 'MEDIUM_VALUE'\r\n",
        "        ELSE 'REGULAR'\r\n",
        "    END AS customer_segment,\r\n",
        "\r\n",
        "    COUNT(*) AS customers,\r\n",
        "    ROUND(SUM(total_spend), 2) AS revenue\r\n",
        "\r\n",
        "FROM retail_lakehouse.gold.gold_customers\r\n",
        "\r\n",
        "GROUP BY\r\n",
        "    CASE\r\n",
        "        WHEN total_spend >= 20000 THEN 'VIP'\r\n",
        "        WHEN total_spend >= 10000 THEN 'HIGH_VALUE'\r\n",
        "        WHEN total_spend >= 5000 THEN 'MEDIUM_VALUE'\r\n",
        "        ELSE 'REGULAR'\r\n",
        "    END\r\n",
        "\r\n",
        "ORDER BY revenue DESC;"
      ]
    }
  ],
